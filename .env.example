# Copy to backend/.env. Every value is optional except at least one owner key for the free demo.

# Owner keys used for free demo runs (visitors can bring their own instead).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# claude | openai — provider used when the request does not name one
DEFAULT_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-5-5
# Required to use OpenAI at all, e.g. the current GPT model id you want
OPENAI_MODEL=

# Free tier on the owner's key
FREE_RUNS_PER_DAY=3
MAX_FREE_RUNS_TOTAL_PER_DAY=100

# Input and body limits
MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=30000
MAX_CONTEXT_CHARS=2000
MAX_BODY_KB=1024

# JSON list of frontend origins allowed by CORS
ALLOWED_ORIGINS=["http://localhost:5173"]

# true only behind a proxy that appends X-Forwarded-For (e.g. Render); free quota is per that IP
TRUST_PROXY=false
